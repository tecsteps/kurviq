      "link": null,
      "locked": false,
      "customData": {
        "rich": {
          "v": 1,
          "p": [
            {
              "r": [
                {
                  "t": "Share a scene with people by email, as in Google Drive: "
                },
                {
                  "t": "Can edit",
                  "b": true
                },
                {
                  "t": " or "
                },
                {
                  "t": "Can view",
                  "b": true
                },
                {
                  "t": "."
                }
              ]
            },
            {
              "r": []
            },
            {
              "r": [
                {
                  "t": "Google emails them the link; they sign in with their Google account"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Their changes are merged with yours element by element"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Viewers can watch, present and make a copy"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Drive decides: access removed in Drive is removed in Kurviq"
                }
              ],
              "k": "ul"
            }
          ]
        }
      },
      "text": "Share a scene with people by email, as in \nGoogle Drive: Can edit or Can view.\n\n• Google emails them the link; they sign in \nwith their Google account\n• Their changes are merged with yours \nelement by element\n• Viewers can watch, present and make a \ncopy\n• Drive decides: access removed in Drive is \nremoved in Kurviq",
      "fontSize": 34,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Share a scene with people by email, as in Google Drive: Can edit or Can view.\n\n• Google emails them the link; they sign in with their Google account\n• Their changes are merged with yours element by element\n• Viewers can watch, present and make a copy\n• Drive decides: access removed in Drive is removed in Kurviq",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
