      "seed": 1704703394,
      "version": 5,
      "versionNonce": 724414544,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793463017199,
      "created": 1792690073525,
      "link": null,
      "locked": false,
      "customData": {
        "rich": {
          "v": 1,
          "p": [
            {
              "r": [
                {
                  "t": "Sign in with Google and every scene is a file in a folder "
                },
                {
                  "t": "Kurviq",
                  "c": "#6965db"
                },
                {
                  "t": " in your Drive. Kurviq sees only the files it made or you opened with it."
                }
              ]
            },
            {
              "r": []
            },
            {
              "r": [
                {
                  "t": "Saved by itself, about 10 s after you stop drawing"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Changes from your other devices and from people you share with are "
                },
                {
                  "t": "merged element by element",
                  "b": true
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "History: Drive keeps old versions for 30 days"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Optional: without Google, scenes stay in your browser"
                }
              ],
              "k": "ul"
            }
          ]
        }
      },
      "text": "Sign in with Google and every scene is a file \nin a folder Kurviq in your Drive. Kurviq sees \nonly the files it made or you opened with it.\n\n• Saved by itself, about 10 s after you \nstop drawing\n• Changes from your other devices and from \npeople you share with are merged element \nby element\n• History: Drive keeps old versions for 30 \ndays\n• Optional: without Google, scenes stay in \nyour browser",
      "fontSize": 34,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sign in with Google and every scene is a file in a folder Kurviq in your Drive. Kurviq sees only the files it made or you opened with it.\n\n• Saved by itself, about 10 s after you stop drawing\n• Changes from your other devices and from people you share with are merged element by element\n• History: Drive keeps old versions for 30 days\n• Optional: without Google, scenes stay in your browser",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
