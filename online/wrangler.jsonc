// Kurviq on Cloudflare: one Worker serves the app (static assets), Sign in
// with Google (/auth), public scenes from Google Drive (/api/public), agent
// pairings (Durable Object) and the remote MCP.
// Deploy: `npm run deploy:online` in the project root. Secrets (set once,
// see README): GOOGLE_CLIENT_SECRET, COOKIE_KEY, GOOGLE_API_KEY. The Google
// client id and other public values: ./google.json.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurviq",
  "main": "build/worker.js",
  "no_bundle": true,
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the Worker sees the pages: it serves its own routes and redirects www
    // to kurviq.com (one origin = one browser storage). The app's files
    // (/assets, /fonts: most requests of a page load) are served without it,
    // so they don't count as Worker requests; their headers come from _headers
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "Pairing" },
      // live sync (docs/live-sync): one per Drive scene, one per account
      { "name": "SCENE", "class_name": "SceneRoom" },
      { "name": "ACCOUNT", "class_name": "AccountGuard" },
      // the fake Google for local tests (only used with FAKE_GOOGLE=1)
      { "name": "FAKE_GOOGLE_STORE", "class_name": "FakeGoogle" },
      // usage statistics: anonymous counters per hour, written to D1 (worker/stats.ts, CLAUDE.md)
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pairing"] },
    { "tag": "v2", "new_sqlite_classes": ["SceneRoom", "AccountGuard", "FakeGoogle"] },
    { "tag": "v3", "new_sqlite_classes": ["Stats"] }
  ],
  // bug reports and change requests (worker/feedback.ts), usage statistics (stats_hourly, stats_daily: worker/stats.ts)
  "d1_databases": [
    { "binding": "FEEDBACK", "database_name": "kurviq-feedback", "database_id": "b0ab0f4a-ee15-4287-baaa-5043937f5952" }
  ],
  "vars": {
    "CANONICAL_HOST": "kurviq.com",
    // live sync: "off", "all", or the accounts (emails) that pilot it; scenes
    // already marked kurviqSync stay live for everyone (docs/live-sync/PROTOCOL.md)
    "LIVE_SYNC": "fabian.wesner@gmail.com",
    // usage statistics (worker/stats.ts): "on", anything else = off; off in wrangler dev unless STATS_DEV=1
    "STATS_ENABLED": "on"
  },
  // hourly: retention (worker/retention.ts) — feedback deleted after 2 years, contact messages after 1 year,
  // their sender hashes blanked after 1 day
  "triggers": { "crons": ["17 * * * *"] },
  // the contact form's email to the operator (worker/contact.ts), sent from contact@kurviq.com. Email
  // Routing on kurviq.com is enabled with fabian.wesner@tecsteps.com as the verified destination
  // (set up 2026-10-31; no routing rules). Without the binding, messages are only stored in D1.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "fabian.wesner@tecsteps.com" }
  ],
  "routes": [
    { "pattern": "kurviq.com", "custom_domain": true },
    { "pattern": "www.kurviq.com", "custom_domain": true }
  ],
  // no request logs (see /privacy); `wrangler tail` still works live when debugging
  "observability": { "enabled": false }
}
