# Copy to .env and adjust.
# --- Kurviq (Excalidraw scenes, synced with Google Drive in the browser) ---
SCENES_SERVER_PORT=3101
# where the frontend reaches the scenes server
SCENES_SERVER_URL=http://localhost:3101
# the app's URL (Herd proxy draw.test -> localhost:3001, see README);
# used for the headless renderer and in messages to agents.
# Without Herd: http://localhost:3001 or http://draw.localhost:3001
SCENES_APP_URL=http://draw.test

# Where the local install signs in with Google (default https://kurviq.com)
# KURVIQ_AUTH_URL=https://kurviq.com

# --- Kurviq online, local test (npm run dev:online) ---
# The Google OAuth client's secret (online/dev-vars.mjs, online/secrets.mjs)
# KURVIQ_GOOGLE_CLIENT_SECRET=
# Google API key restricted to the Drive API (public scenes, server side)
# KURVIQ_GOOGLE_API_KEY=
