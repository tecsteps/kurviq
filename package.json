{
  "name": "kurviq",
  "private": true,
  "type": "module",
  "description": "Local Excalidraw with git-backed multi-scene support. Upstream excalidraw lives untouched in ./excalidraw",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "start:server": "node scenes-server/server.mjs",
    "start:app": "cd excalidraw/excalidraw-app && ../node_modules/.bin/vite --config ../../scenes-plugin/vite.config.mts",
    "typecheck": "excalidraw/node_modules/.bin/tsc -p scenes-plugin/tsconfig.json",
    "setup:domain": "herd proxy draw http://localhost:3001",
    "build:online": "cd excalidraw/excalidraw-app && SCENES_TARGET=online ../node_modules/.bin/vite build --config ../../scenes-plugin/vite.config.mts",
    "dev:online": "npm run build:online && cd online && npm run dev",
    "build:online:fake": "KURVIQ_FAKE_GOOGLE=1 npm run build:online",
    "deploy:online": "npm run build:online && cd online && npm run deploy"
  }
}
